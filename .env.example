# Copia questo file in `.env.local` e compila i valori reali.

# Numero WhatsApp Business in formato internazionale, SOLO cifre
# (prefisso 39 per l'Italia, niente "+", spazi o zeri iniziali doppi).
# Esempio: 393471234567
NEXT_PUBLIC_WHATSAPP_NUMBER=390000000000

# URL pubblico definitivo del sito (usato per metadata, Open Graph e JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.damiri.it
